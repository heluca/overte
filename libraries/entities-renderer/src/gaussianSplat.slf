INPUT(0, vec4, _splatColor);
INPUT(1, vec3, _splatConic);
INPUT(2, vec2, _splatOffset);

// The deferred transparent pass and the forward pass both draw into a single colour target at location 0.
OUTPUT(0, vec4, _fragColor0);

void main(void) {
    vec2 d = _splatOffset;
    float power = -0.5 * (_splatConic.x * d.x * d.x + _splatConic.z * d.y * d.y) - _splatConic.y * d.x * d.y;
    // Capped below 1 as in the reference renderer, so a dense core never hides everything behind it in one layer.
    float alpha = min(0.99, _splatColor.a * exp(power));
    if (alpha < 1.0 / 255.0) {
        discard;
    }
    // Premultiplied: the pipeline blends ONE, INV_SRC_ALPHA, back to front.
    _fragColor0 = vec4(_splatColor.rgb * alpha, alpha);
}
