void GaussianSplatEntityItem::debugDump() const {
    qCDebug(entities) << "GaussianSplatEntityItem id:" << getEntityItemID() << "---------------------------------------------";
    qCDebug(entities) << "    name:" << _name;
    qCDebug(entities) << "    position:" << debugTreeVector(getWorldPosition());
    qCDebug(entities) << "    dimensions:" << debugTreeVector(getScaledDimensions());
    qCDebug(entities) << "    editedAgo:" << debugTime(getLastEdited(), usecTimestampNow());
    qCDebug(entities) << "    pointer:" << this;

@GaussianSplat_ENTITY_DEBUG@

}

void GaussianSplatEntityItem::setNaturalDimension(const glm::vec3& naturalDimensions) const {
    withWriteLock([&] {
        _naturalDimensions = naturalDimensions;
    });
}

bool GaussianSplatEntityItem::isInsidePickBox(const glm::vec3& point, const glm::vec3& viewFrustumPos,
                                              glm::quat& rotation) const {
    // The same entity-frame box EntityTreeElement::evalDetailedRayIntersection tests the pick against.
    glm::vec3 position = getWorldPosition();
    BillboardMode billboardMode = getBillboardMode();
    glm::quat orientation = billboardMode == BillboardMode::NONE ? getWorldOrientation() : getLocalOrientation();
    rotation = BillboardModeHelpers::getBillboardRotation(position, orientation, billboardMode, viewFrustumPos,
                                                          getRotateForPicking());
    glm::mat4 worldToEntityMatrix = glm::inverse(glm::translate(position) * glm::mat4_cast(rotation));
    glm::vec3 dimensions = getScaledDimensions();
    AABox entityFrameBox(-(dimensions * getRegistrationPoint()) + getPivot(), dimensions);
    return entityFrameBox.contains(glm::vec3(worldToEntityMatrix * glm::vec4(point, 1.0f)));
}

bool GaussianSplatEntityItem::findDetailedRayIntersection(const glm::vec3& origin, const glm::vec3& direction,
                                                          const glm::vec3& viewFrustumPos, OctreeElementPointer& element,
                                                          float& distance, BoxFace& face, glm::vec3& surfaceNormal,
                                                          QVariantMap& extraInfo, bool precisionPicking) const {
    // Keeps the box hit the caller already computed. The caller copies a detailed hit's normal back unrotated, so the
    // entity-frame box normal is rotated to world here.
    glm::quat rotation;
    if (isInsidePickBox(origin, viewFrustumPos, rotation)) {
        return false;
    }
    surfaceNormal = rotation * surfaceNormal;
    return true;
}

bool GaussianSplatEntityItem::findDetailedParabolaIntersection(const glm::vec3& origin, const glm::vec3& velocity,
                                                               const glm::vec3& acceleration, const glm::vec3& viewFrustumPos,
                                                               OctreeElementPointer& element, float& parabolicDistance,
                                                               BoxFace& face, glm::vec3& surfaceNormal,
                                                               QVariantMap& extraInfo, bool precisionPicking) const {
    glm::quat rotation;
    if (isInsidePickBox(origin, viewFrustumPos, rotation)) {
        return false;
    }
    surfaceNormal = rotation * surfaceNormal;
    return true;
}
