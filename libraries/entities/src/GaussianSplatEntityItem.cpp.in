#include "GaussianSplatEntityItem.h"

#include <glm/gtx/transform.hpp>

#include <BillboardMode.h>

#include "EntityItemProperties.h"

EntityItemPointer GaussianSplatEntityItem::factory(const EntityItemID& entityID, const EntityItemProperties& properties) {
    Pointer entity(new GaussianSplatEntityItem(entityID), [](GaussianSplatEntityItem* ptr) { ptr->deleteLater(); });
    entity->setProperties(properties);
    return entity;
}

GaussianSplatEntityItem::GaussianSplatEntityItem(const EntityItemID& entityItemID) : EntityItem(entityItemID) {
    _type = EntityTypes::GaussianSplat;
}

EntityItemProperties GaussianSplatEntityItem::getProperties(const EntityPropertyFlags& desiredProperties, bool allowEmptyDesiredProperties) const {
    EntityItemProperties properties = EntityItem::getProperties(desiredProperties, allowEmptyDesiredProperties); // get the properties from our base class

@GaussianSplat_ENTITY_COPY_TO@

    withReadLock([&] {
        properties.setNaturalDimensions(_naturalDimensions);
    });

    return properties;
}

bool GaussianSplatEntityItem::setSubClassProperties(const EntityItemProperties& properties) {
    bool somethingChanged = false;

@GaussianSplat_ENTITY_SET_FROM@

    return somethingChanged;
}

EntityPropertyFlags GaussianSplatEntityItem::getEntityProperties(EncodeBitstreamParams& params) const {
    EntityPropertyFlags requestedProperties = EntityItem::getEntityProperties(params);

@GaussianSplat_REQUESTED_PROPS@

    return requestedProperties;
}

