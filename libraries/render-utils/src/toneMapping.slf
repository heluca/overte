<@include render-utils/ShaderConstants.h@>

struct ToneMappingParams {
    // The zone's exposure, in EV
    float _exposure;
    // Auto exposure: log2 of the key luminance, and how far above/below the zone's exposure it may go, in EV
    float _autoKeyLog2;
    float _autoRangeUp;
    float _autoRangeDown;
    int _toneCurve;
    int _autoEnabled;
    int _autoDebug;
    // HDR output: the brightest value the display shows, as a multiple of SDR white; 0 when the output is SDR
    float _hdrPeak;
    // HDR output: the swapchain value of SDR white; the curves work in SDR white units and the output is scaled by it
    float _hdrWhite;
};

const float GAMMA_22 = 2.2;
const float INV_GAMMA_22 = 1.0 / 2.2;
const int ToneCurveNone = 0;
const int ToneCurveGamma22 = 1;
const int ToneCurveReinhard = 2;
const int ToneCurveFilmic = 3;

UNIFORM_BUFFER(RENDER_UTILS_BUFFER_TM_PARAMS, toneMappingParamsBuffer) {
    ToneMappingParams params;
};
int getToneCurve() {
    return params._toneCurve;
}

TEXTURE(RENDER_UTILS_TEXTURE_TM_COLOR, sampler2D, colorMap);
// 1x1, the adapted average log2 luminance of the lighting buffer measured by the auto exposure pass
TEXTURE(RENDER_UTILS_TEXTURE_TM_ADAPTATION, sampler2D, adaptationMap);

INPUT(0, vec2, varTexCoord0);
OUTPUT(0, vec4, outFragColor);

float luminance(vec3 v) {
    return dot(v, vec3(0.2126, 0.7152, 0.0722));
}

vec3 changeLuminance(vec3 colorIn, float luminanceOut) {
    float luminanceIn = luminance(colorIn);
    return colorIn * (luminanceOut / luminanceIn);
}

// The ACES fit (Stephen Hill), per channel, applied in the ACES input space
vec3 acesCurve(vec3 v) {
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}
float acesCurve(float v) {
    return acesCurve(vec3(v)).x;
}
float acesSlope(float v) {
    float a = v * (v + 0.0245786) - 0.000090537;
    float b = v * (0.983729 * v + 0.4329510) + 0.238081;
    float da = 2.0 * v + 0.0245786;
    float db = 2.0 * 0.983729 * v + 0.4329510;
    return (da * b - a * db) / (b * b);
}

void main(void) {
<@if HIFI_USE_MIRRORED@>
    vec4 fragColorRaw = texture(colorMap, vec2(1.0 - varTexCoord0.x, varTexCoord0.y));
<@else@>
    vec4 fragColorRaw = texture(colorMap, varTexCoord0);
<@endif@>
    vec3 fragColor = fragColorRaw.xyz;

    float exposure = params._exposure;
    float adapted = 0.0;
    if (params._autoEnabled != 0) {
        // Add whatever brings the exposed average luminance to the key, within the range allowed around the zone's exposure
        adapted = texelFetch(adaptationMap, ivec2(0, 0), 0).x;
        exposure += clamp(params._autoKeyLog2 - (adapted + exposure), -params._autoRangeDown, params._autoRangeUp);
    }
    vec3 srcColor = fragColor * exp2(exposure);

    // HDR output: the display shows linear values up to peak times SDR white
    float peak = params._hdrPeak;

    int toneCurve = getToneCurve();
    vec3 tonedColor = srcColor;
    if (toneCurve == ToneCurveFilmic) {
        const mat3 acesInput = mat3(
            0.59719, 0.07600, 0.02840,
            0.35458, 0.90834, 0.13383,
            0.04823, 0.01566, 0.83777
        );
        const mat3 acesOutput = mat3(
            1.60475, -0.10208, -0.00327,
            -0.53108, 1.10813, -0.07276,
            -0.07367, -0.00605, 1.07602
        );

        tonedColor = acesInput * tonedColor;

        if (peak > 0.0) {
            // The SDR curve up to the knee, so the midtones look as they do in SDR, then a soft shoulder that starts
            // with the curve's slope at the knee and rises to the display's peak instead of rolling off to white
            const float KNEE = 0.5;
            float kneeOut = acesCurve(KNEE);
            float kneeSlope = acesSlope(KNEE);
            vec3 below = acesCurve(min(tonedColor, vec3(KNEE)));
            vec3 above = max(tonedColor - vec3(KNEE), vec3(0.0));
            tonedColor = below + (peak - kneeOut) * (vec3(1.0) - exp(-kneeSlope * above / (peak - kneeOut)));
            tonedColor = acesOutput * tonedColor;
            tonedColor = clamp(tonedColor, vec3(0.0), vec3(peak));
        } else {
            tonedColor = acesCurve(tonedColor);
            tonedColor = acesOutput * tonedColor;
            tonedColor = clamp(tonedColor, vec3(0.0), vec3(1.0));
        }
    } else if (toneCurve == ToneCurveReinhard) {
        // In HDR the curve is stretched to end at the peak: Reinhard is linear through the midtones, so they hold
        float range = (peak > 0.0) ? peak : 1.0;
        const float whitePoint = 2.0;
        float luminanceOld = luminance(srcColor) / range;
        float numerator = luminanceOld * (1.0 + (luminanceOld / (whitePoint * whitePoint)));
        float luminanceNew = numerator / (1.0 + luminanceOld);
        tonedColor = changeLuminance(srcColor, luminanceNew * range);
    } else if (toneCurve == ToneCurveGamma22) {
        // We use glEnable(GL_FRAMEBUFFER_SRGB), which automatically converts textures from RGB to SRGB
        // when writing from an RGB framebuffer to an SRGB framebuffer (note that it doesn't do anything
        // when writing from an SRGB framebuffer to an RGB framebuffer).
        // Since the conversion happens automatically, we don't need to do anything in this shader.
        // An HDR (float, linear) output has no such conversion and no clip, so the values are only held to the peak.
        if (peak > 0.0) {
            tonedColor = min(srcColor, vec3(peak));
        }
    } else {
        // toneCurve == ToneCurveNone
        // For debugging purposes, we may want to see what the colors look like before the automatic OpenGL
        // conversion mentioned above, so we undo it here (an HDR output is linear already)
        if (peak <= 0.0) {
            tonedColor = pow(srcColor, vec3(GAMMA_22));
        }
    }

    if (params._autoDebug != 0 && gl_FragCoord.x < 64.0 && gl_FragCoord.y < 16.0) {
        // Numeric probe for tuning: a grey patch whose value, read back linearly, is (adapted + 12) / 16
        float probe = clamp((adapted + 12.0) / 16.0, 0.0, 1.0);
        tonedColor = vec3(pow(probe, GAMMA_22));
    }

    if (peak > 0.0) {
        tonedColor *= params._hdrWhite;
    }
    outFragColor = vec4(tonedColor, 1.0);
}
