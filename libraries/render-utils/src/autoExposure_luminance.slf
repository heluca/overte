<@include gpu/Config.slh@>
<$VERSION_HEADER$>
//  autoExposure_luminance.slf
//  libraries/render-utils/src
//
//  First step of auto exposure: the average log2 luminance of the lighting buffer, one texel per block of the viewport.
//
