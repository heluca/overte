<@include gpu/Color.slh@>

TEXTURE(0, sampler2D, colorMap);

struct DrawHUDTextureHDRParams {
    // x: the swapchain value of SDR white
    vec4 white;
};

// binding=0 must match hudHDRParamsSlot in VulkanDisplayPlugin.cpp
UNIFORM_BUFFER(0, drawHUDTextureHDRParams) {
    DrawHUDTextureHDRParams params;
};

INPUT(0, vec2, varTexCoord0);
OUTPUT(0, vec4, outFragColor);

void main(void) {
    vec4 color = texture(colorMap, varTexCoord0);

    // Qt gives a premultiplied texture; un-premultiply or there are black halos around transparent parts
    color.rgb /= max(0.004 /* 1.0 / 255.0 */, color.a);

    color = color_sRGBAToLinear(color);
    outFragColor = vec4(color.rgb * params.white.x, color.a);
}
